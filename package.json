{
  "name": "aahaarloop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "web": "pnpm --filter @aahaarloop/web dev",
    "mobile": "pnpm --filter @aahaarloop/mobile dev",
    "android": "pnpm --filter @aahaarloop/mobile android",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "~6.0.3"
  }
}
