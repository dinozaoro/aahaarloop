# Copy this file to .env.local (or export the variables in your shell).
# Fill in real values from the Neon console. Never commit a filled-in env file.
# See docs/development/environment.md for owners and per-environment setup.

# Pooled Neon connection string used by the running app. REQUIRED.
DATABASE_URL=postgresql://USER:PASSWORD@ep-pooled.REGION.neon.tech/DB_NAME?sslmode=require

# Direct Neon connection string, used by migrations only. Optional locally.
DIRECT_URL=postgresql://USER:PASSWORD@ep-direct.REGION.neon.tech/DB_NAME?sslmode=require

# Public web URL, used for canonical links and OAuth callbacks. REQUIRED.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL the Expo app calls. REQUIRED for mobile.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Auth.js session encryption secret: generate with `openssl rand -base64 32`. REQUIRED.
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth client credentials. REQUIRED for Google sign-in.
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Cloudinary direct-upload credentials. SERVER-SIDE ONLY: never prefix with NEXT_PUBLIC_.
# Required for donation image uploads; the API secret is used only to sign requests.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Sightengine image authenticity (OPTIONAL, server-only). When absent the
# authenticity check simply reports "unavailable" and publishing still works.
SIGHTENGINE_API_USER=your-sightengine-api-user
SIGHTENGINE_API_SECRET=your-sightengine-api-secret
